# ------------------------------
# PostgreSQL
# ------------------------------
POSTGRES_URL=jdbc:postgresql://localhost:5433/mei_platform
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=mei_platform

# ------------------------------
# OpenSearch (reserved for future hybrid search)
# ------------------------------
OPEN_SEARCH_URL=http://localhost:9200
OPENSEARCH_PASSWORD=StrongPassword123!

# ------------------------------
# Neo4j (reserved for future knowledge-graph features)
# ------------------------------
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# ------------------------------
# LLM Configuration
# Free option: Hugging Face Inference API (https://huggingface.co/settings/tokens)
# Get a free token and set HF_TOKEN. Leave empty to fall back to raw retrieved text.
# ------------------------------
LLM_PROVIDER=huggingface
HF_TOKEN=
HF_MODEL=google/flan-t5-large
USE_LLM=true

# ------------------------------
# Embeddings
# ------------------------------
EMBEDDING_MODEL=all-MiniLM-L6-v2
RAG_TOP_K=5

# ------------------------------
# JWT Security (change in production!)
# ------------------------------
JWT_SECRET=super_secret_jwt_key_that_should_be_long_and_secure
SEED_DEFAULT_USERS=true

# ------------------------------
# Microservices
# ------------------------------
AI_SERVICE_URL=http://localhost:8000