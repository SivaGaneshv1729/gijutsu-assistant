# ------------------------------
# PostgreSQL
# ------------------------------
POSTGRES_URL=jdbc:postgresql://localhost:5433/mei_platform
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=mei_platform

# ------------------------------
# OpenSearch (reserved for future hybrid search)
# ------------------------------
OPEN_SEARCH_URL=http://localhost:9200
OPENSEARCH_PASSWORD=StrongPassword123!

# ------------------------------
# Neo4j (knowledge graph)
# ------------------------------
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# ------------------------------
# LLM Configuration (100% local via Ollama)
# Install Ollama: https://ollama.com
# Pull a model: ollama pull mistral
# No API keys needed — runs entirely on your machine.
# ------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral
USE_LLM=true

# ------------------------------
# Embeddings (local, zero cost)
# ------------------------------
EMBEDDING_MODEL=all-MiniLM-L6-v2
RAG_TOP_K=5
RERANK_ENABLED=true
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ------------------------------
# JWT Security (change in production!)
# ------------------------------
JWT_SECRET=super_secret_jwt_key_that_should_be_long_and_secure
SEED_DEFAULT_USERS=true

# ------------------------------
# Microservices
# ------------------------------
AI_SERVICE_URL=http://localhost:8000
